    <svg id="boss_svg" width="300" height="300" viewBox="0 0 180 180" role="img" aria-label="Angry circle boss">
        <circle cx="90" cy="90" r="65" fill="#b71f58" stroke="#ff8aa9" stroke-width="4" />
        
        <path d="M48 59 L76 70 L72 81 L45 72 Z" fill="#210817" />
        <path d="M104 70 L132 59 L135 72 L108 81 Z" fill="#210817" />
        
