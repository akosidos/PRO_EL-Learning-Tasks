    <title>6.4 Engage - Learning Task 6.2</title>
    <style>
        html, body {
            margin: 0;
            height: 100%;
            background: #ffffff;
            display: grid;
            place-items: center;
        }

        #boss_svg {
            width: 300px;
            height: 300px;
            animation: pulse 1.5s ease-in-out infinite alternate;
        }

        @keyframes pulse {
            from { transform: scale(1.5); }
            to   { transform: scale(0.5); }
        }
    </style>
</head>
